  "main": "index.js",
  "bin": {
    "ai-readme-mcp": "./index.js"
  },
  "homepage": "https://github.com/Draco-Cheng/ai-readme-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Draco-Cheng/ai-readme-mcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "openclaw": {
    "extensions": ["mcp"],
    "compat": {
      "pluginApi": "*"
    },
    "build": {
      "openclawVersion": "0.9.0"
    }
  }
}
